# Empty uses the Vite /api proxy. Set an API origin for a separately hosted backend.
VITE_API_BASE_URL=

# Live social is enabled by default. Set false to hide Friends and party routes.
VITE_SOCIAL_ENABLED=true
# Production and CI previews use real data only. Local development defaults to
# sample mode when omitted; set false here to use the real party backend locally.
VITE_SOCIAL_DEMO_ENABLED=false

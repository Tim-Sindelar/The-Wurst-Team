{
  "name": "hackathon-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:social-draft": "node --experimental-strip-types --test tests/social-draft.test.mjs",
    "test": "node --test tests/*.test.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix",
    "api:generate": "uv run --locked --project ../backend export-openapi && openapi-ts"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  },
  "dependencies": {
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@mantine/notifications": "9.7.1",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@tanstack/react-query": "5.104.1",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.13.0",
    "polygon-clipping": "0.15.7",
    "qr-scanner": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "postcss": "8.5.29",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
